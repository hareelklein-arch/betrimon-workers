{
  "name": "betrimon-workers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/prisma-generate.mjs",
    "dev": "prisma generate --schema=prisma/schema.sqlite.prisma && next dev --turbopack",
    "build": "node scripts/prisma-generate.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push --schema=prisma/schema.sqlite.prisma",
    "db:seed": "prisma generate --schema=prisma/schema.sqlite.prisma && tsx prisma/seed.ts",
    "db:reset": "prisma db push --schema=prisma/schema.sqlite.prisma && tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "iron-session": "^9.0.1",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "prisma": "^6.16.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
